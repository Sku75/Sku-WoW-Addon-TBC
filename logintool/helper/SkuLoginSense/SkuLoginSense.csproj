<Project Sdk="Microsoft.NET.Sdk">

  <!-- Out-of-process sensing helper for the WoW Login Tool.
       .NET Framework 4.8: in-box on Win10/11, no runtime to bundle (hard rule:
       no self-contained .NET, no cloud services - capture + OCR are OS parts). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SkuLoginSense</AssemblyName>
    <RootNamespace>SkuLoginSense</RootNamespace>
    <Version>0.1.0</Version>
    <!-- WinRT (Windows.Media.Ocr, Windows.Graphics.Capture) from net48. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.Contracts" Version="10.0.22621.3233" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>
  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
