# Bulky binary assets — stay on disk / ship in the release zip, not in git
# (same rule as Sku/ and SkuMapper/: source is tracked, assets are not).
CopyTheContentOfThisFolderToInterface/
data/screenshots/
data/localization/translations.xlsx

# Runtime files
log.txt
log-*.txt

# Helper build output
helper/**/bin/
helper/**/obj/

# Texture backups made by tools/make_fiducial_textures.py (bulky, like the
# textures themselves; the pristine originals also live in the release zips)
tools/texture_originals/

# Release zip output (ships as a GitHub release asset, not in git)
dist/

# v2 smoke-test output
v2/test_sense_out.txt
