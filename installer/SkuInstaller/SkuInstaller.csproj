<Project Sdk="Microsoft.NET.Sdk">

  <!-- Matches the Accessible Arena installer: .NET Framework 4.7.2 WinForms.
       WinForms native controls are read correctly by NVDA/JAWS out of the box. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SkuInstaller</AssemblyName>
    <RootNamespace>SkuInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Single source of truth for the installer's own version. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- JavaScriptSerializer for parsing the GitHub releases JSON. -->
    <Reference Include="System.Web.Extensions" />
    <!-- Required for the `dynamic` late-binding used to create .lnk shortcuts. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
