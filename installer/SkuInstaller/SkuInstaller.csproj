<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 WinForms. Native WinForms controls are read correctly
       by NVDA/JAWS out of the box.

       Was net472 until the wizard rework. Bumped to net48 because
       ScreenReaderAnnouncer needs System.Windows.Forms.Automation
       (AutomationNotificationKind / AutomationNotificationProcessing), which the
       net472 reference assemblies do not expose — without it the installer
       cannot speak its own progress, which is the entire point of the rework.
       4.8 ships in Windows 10 1903+ and every Windows 11, and the KOTOR
       accessibility installer already targets it for the same user base. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SkuInstaller</AssemblyName>
    <RootNamespace>SkuInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Single source of truth for the installer's own version. Surfaced in the
         window title (WizardForm.InstallerVersion) so it's announced by the
         screen reader, and written onto the download page by release.ps1.

         This is the INSTALLER's version and is deliberately independent of the
         Sku addon version: an addon release usually ships the same installer,
         and an installer fix can ship without a new addon. release.ps1 keeps
         both straight - it rebuilds and attaches the exe to every addon release,
         and -PublishInstaller ships a new exe on its own.

         4.0 = the guided-wizard rework: spoken progress (UIA), one run across
         several WoW clients, per-client folder confirmation, self-updating
         progress rows, a real Cancel button.
         4.1 = French: Loc.Lang.Fr (same key set as en/de, picked from the OS UI
         culture, switchable in the language list built from
         ComponentsForm._langOrder).
         4.2 = "Collect all logs": one button on the opening screen bundles every
         log of EVERY detected client — Sku's SavedVariables (SkuDebugLog +
         SkuErrorLog), BugGrabber, WVDebug, the client's Logs\ and Errors\,
         Config.wtf, the addon list, the login tool's log and this installer's own
         log — into one zip in Downloads (LogCollector). -->
    <Version>4.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- JavaScriptSerializer for parsing the GitHub releases JSON. -->
    <Reference Include="System.Web.Extensions" />
    <!-- Required for the `dynamic` late-binding used to create .lnk shortcuts. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled SAPI2SR NVDA-SAPI bridge payload (x64 bookmark-fixed engine +
         x86 + companions + the signing script). Extracted+installed at runtime
         by Sapi2SrInstaller. -->
    <EmbeddedResource Include="payload\sapi2sr-payload.zip" />
    <!-- Portable AutoHotkey v2 runtime + GPL license, dropped next to the WoW
         Login Tool so it runs without a system-wide AHK install. Runs the
         v2\START.ahk driver. Deployed at runtime by LoginToolInstaller. -->
    <EmbeddedResource Include="payload\AutoHotkey64_v2.exe" />
    <EmbeddedResource Include="payload\AutoHotkey-license.txt" />
  </ItemGroup>

</Project>
