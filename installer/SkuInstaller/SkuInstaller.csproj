<Project Sdk="Microsoft.NET.Sdk">

  <!-- Matches the Accessible Arena installer: .NET Framework 4.7.2 WinForms.
       WinForms native controls are read correctly by NVDA/JAWS out of the box. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SkuInstaller</AssemblyName>
    <RootNamespace>SkuInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Single source of truth for the installer's own version. Surfaced in the
         window title (MainForm.InstallerVersion) so it's announced by the screen
         reader; trailing zero components are dropped, so 3.0.0 shows as "v3". -->
    <Version>3.0.2</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- JavaScriptSerializer for parsing the GitHub releases JSON. -->
    <Reference Include="System.Web.Extensions" />
    <!-- Required for the `dynamic` late-binding used to create .lnk shortcuts. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled SAPI2SR NVDA-SAPI bridge payload (x64 bookmark-fixed engine +
         x86 + companions + the signing script). Extracted+installed at runtime
         by Sapi2SrInstaller. -->
    <EmbeddedResource Include="payload\sapi2sr-payload.zip" />
    <!-- Portable AutoHotkey v2 runtime + GPL license, dropped next to the WoW
         Login Tool so it runs without a system-wide AHK install. Runs the
         v2\START.ahk driver. Deployed at runtime by LoginToolInstaller. -->
    <EmbeddedResource Include="payload\AutoHotkey64_v2.exe" />
    <EmbeddedResource Include="payload\AutoHotkey-license.txt" />
  </ItemGroup>

</Project>
