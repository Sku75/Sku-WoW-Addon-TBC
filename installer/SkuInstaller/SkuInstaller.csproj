<Project Sdk="Microsoft.NET.Sdk">

  <!-- Matches the Accessible Arena installer: .NET Framework 4.7.2 WinForms.
       WinForms native controls are read correctly by NVDA/JAWS out of the box. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SkuInstaller</AssemblyName>
    <RootNamespace>SkuInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Single source of truth for the installer's own version. -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- JavaScriptSerializer for parsing the GitHub releases JSON. -->
    <Reference Include="System.Web.Extensions" />
    <!-- Required for the `dynamic` late-binding used to create .lnk shortcuts. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled SAPI2SR NVDA-SAPI bridge payload (x64 bookmark-fixed engine +
         x86 + companions + the signing script). Extracted+installed at runtime
         by Sapi2SrInstaller. -->
    <EmbeddedResource Include="payload\sapi2sr-payload.zip" />
    <!-- Portable AutoHotkey runtimes + GPL license, dropped next to the WoW
         Login Tool so it runs without a system-wide AHK install. v1.1 runs the
         legacy START.ahk fallback, v2 runs the reworked v2\START.ahk driver
         (preferred when present). Deployed at runtime by LoginToolInstaller. -->
    <EmbeddedResource Include="payload\AutoHotkeyU64.exe" />
    <EmbeddedResource Include="payload\AutoHotkey64_v2.exe" />
    <EmbeddedResource Include="payload\AutoHotkey-license.txt" />
  </ItemGroup>

</Project>
